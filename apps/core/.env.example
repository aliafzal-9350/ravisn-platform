# ==============================================================================
# RAVISN Core Laravel CRM & Gateway Environment Configuration (.env.example)
# ==============================================================================
APP_NAME="RAVISN Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
AGENT_API_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (PostgreSQL 16 + pgvector) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ravisn_db
DB_USERNAME=postgres
DB_PASSWORD=secret

# --- Session & Queue ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis

# --- Redis Configuration ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
INBOUND_AI_STREAM_KEY=inbound_ai_jobs
CRM_BROADCAST_CHANNEL=crm_channel_updates

# --- Broadcasting (Laravel Reverb) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ravisn_app
REVERB_APP_KEY=ravisn_key
REVERB_APP_SECRET=ravisn_secret
# Server side: PHP containers publish events to Reverb over the docker network.
# For non-docker local dev (composer dev) use REVERB_HOST=localhost.
REVERB_HOST=core-reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Browser side (baked into the frontend build): the address a browser connects to.
# Local dev connects straight to the published port. In production use the public
# domain with port 443 / scheme https; nginx proxies /app/ to Reverb.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# --- Google OAuth Credentials ---
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- AWS S3 Storage ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=ravisn-media-storage
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Meta API & Webhooks ---
META_APP_ID=1373033030986851
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=ravisn-dev-verify-token
META_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_SYSTEM_USER_ACCESS_TOKEN=

# --- Multi-AI Provider Keys (Fallback & Embeddings) ---
GROQ_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

VITE_APP_NAME="${APP_NAME}"
