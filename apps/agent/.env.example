DATABASE_URL=sqlite:///./ravisn_agent.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
JWT_SECRET=change-this-to-a-long-random-string-in-production

# WhatsApp official Cloud API (Phase 3). Leave META_APP_SECRET empty to stay in
# mock mode - replies get logged instead of actually sent to Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=ravisn-dev-verify-token
META_APP_SECRET=

# Facebook + Instagram (Phase 4) - same Meta app/secret as whatsapp official above,
# just a separate webhook verify token since it's a separate webhook subscription.
META_WEBHOOK_VERIFY_TOKEN=ravisn-dev-verify-token

# WhatsApp QR connect (Phase 3b) - the separate Node service in whatsapp-qr-service/.
# This secret must match the same value in whatsapp-qr-service/.env
WHATSAPP_QR_SERVICE_URL=http://localhost:3001
WHATSAPP_QR_INTERNAL_SECRET=dev-internal-secret

# Phase 6: comma-separated list of allowed frontend origins in production, e.g.
# https://app.ravisn.com. Leave as * for local dev only - never in production.
CORS_ORIGINS=*
