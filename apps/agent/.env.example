# ==============================================================================
# RAVISN FastAPI Multi-Agent Engine Environment Configuration (.env.example)
# ==============================================================================

APP_NAME="RAVISN Multi-Agent AI Platform"
APP_ENV=local
DEBUG=true

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://postgres:secret@127.0.0.1:5432/ravisn_db
DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:secret@127.0.0.1:5432/ravisn_db

# Redis Broker & Streams
REDIS_URL=redis://127.0.0.1:6379/0
INBOUND_AI_STREAM_KEY=inbound_ai_jobs
CRM_BROADCAST_CHANNEL=crm_channel_updates
AGENT_WORKER_CONCURRENCY=8

# Meta Graph API
META_APP_ID=1373033030986851
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=ravisn-dev-verify-token
META_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_SYSTEM_USER_ACCESS_TOKEN=

# Multi-AI Provider Priority Cascade
# 1. Primary: Groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# 2. Secondary: Google Gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash

# 3. Tertiary: xAI Grok
XAI_API_KEY=
XAI_CHAT_MODEL=grok-3-mini

# 4. Quaternary: OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Security & CORS
# Must equal AGENT_INTERNAL_TOKEN on the Laravel side; required when APP_ENV=production.
INTERNAL_API_TOKEN=
# Laravel's APP_KEY, used to decrypt channel access tokens stored by Laravel.
APP_KEY=
CORS_ORIGINS=
