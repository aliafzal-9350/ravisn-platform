# ==============================================================================
# UNIFIED RAVISN PLATFORM CONFIGURATION (.env.example)
# ==============================================================================
APP_NAME="RAVISN Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
AGENT_API_URL=http://127.0.0.1:8001

# --- Database (PostgreSQL 16 + pgvector) ---
DB_CONNECTION=pgsql
DB_HOST=your-project-pooler.region.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password
DATABASE_URL=postgresql://neondb_owner:your_neon_password@your-project.region.aws.neon.tech/neondb?sslmode=require
DATABASE_POOLER_URL=postgresql://neondb_owner:your_neon_password@your-project-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_ASYNC_URL=postgresql+asyncpg://neondb_owner:your_neon_password@your-project-pooler.region.aws.neon.tech/neondb?ssl=require
DATABASE_MIGRATION_URL=postgresql://neondb_owner:your_neon_password@your-project.region.aws.neon.tech/neondb?sslmode=require
DB_MIGRATION_MODE=false
DB_SSLMODE=require

# --- Redis Broker & Cache ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_CONNECTION=redis
INBOUND_AI_STREAM_KEY=inbound_ai_jobs
CRM_BROADCAST_CHANNEL=crm_channel_updates

# --- Google OAuth Credentials ---
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- AWS S3 Storage ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=ravisn-media-storage
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Meta API & Webhooks ---
META_APP_ID=1373033030986851
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=ravisn-dev-verify-token
META_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_SYSTEM_USER_ACCESS_TOKEN=

# --- Multi-AI Provider Priority Cascade ---
# 1. Primary Engine: Groq (LLM & Fast Whisper Voice Transcription)
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# 2. Secondary Engine: Google Gemini (High-Speed Fallback)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash

# 3. Tertiary Engine: xAI Grok (Secondary Fallback)
XAI_API_KEY=
XAI_CHAT_MODEL=grok-3-mini

# 4. Quaternary Engine: OpenAI (Fallback & 1536-dim Embeddings)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Security (required by docker-compose.yml) ---
# Generate each with: openssl rand -hex 32   (hex: they are embedded in URLs)
# Redis password for queues, cache, sessions and the agent bridge.
REDIS_PASSWORD=
# Shared secret Laravel sends to the internal agent API (X-Internal-Token).
AGENT_INTERNAL_TOKEN=
# Password of the bundled Postgres container. When using it, set DB_PASSWORD to the same value.
POSTGRES_PASSWORD=
# The agent is internal-only; leave empty so no browser origin can call it.
CORS_ORIGINS=
