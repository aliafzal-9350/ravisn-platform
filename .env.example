# ==============================================================================
# RAVISN Platform: Unified Monorepo Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform & Application Core
# ------------------------------------------------------------------------------
APP_NAME=RAVISN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 2. Database (Unified PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ravisn_platform
DB_USERNAME=postgres
DB_PASSWORD=secure_postgres_pass

POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_postgres_pass
POSTGRES_DB=ravisn_platform

# Python / FastAPI connection string
DATABASE_URL=postgresql://postgres:secure_postgres_pass@postgres:5432/ravisn_platform

# ------------------------------------------------------------------------------
# 3. Redis Cache & Queue Broker
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_URL=redis://redis:6379/0

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. Security, JWT & CORS
# ------------------------------------------------------------------------------
JWT_SECRET=ravisn-dev-jwt-secret-key-change-in-production
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:8000,http://localhost:8080

# ------------------------------------------------------------------------------
# 5. AI & LLM Model Providers
# ------------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (Ultra-fast inference)
GROQ_API_KEY=

# Google Gemini API
GEMINI_API_KEY=

# xAI (Grok)
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Local Ollama
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# ------------------------------------------------------------------------------
# 6. Meta / WhatsApp / Instagram / Facebook Omnichannel
# ------------------------------------------------------------------------------
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_CONFIG_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=ravisn-dev-verify-token

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=ravisn-dev-verify-token

# ------------------------------------------------------------------------------
# 7. WhatsApp QR Device Service (Node.js / Baileys)
# ------------------------------------------------------------------------------
WHATSAPP_QR_SERVICE_URL=http://whatsapp-qr-service:3001
WHATSAPP_QR_INTERNAL_SECRET=dev-internal-secret
WHATSAPP_QR_MOCK=false

# ------------------------------------------------------------------------------
# 8. Logging, Mail & Storage
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@ravisn.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# 9. Frontend & Integrations
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://localhost/api/agent
CALCOM_API_KEY=
