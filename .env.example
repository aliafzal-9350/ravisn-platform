# ==============================================================================
# UNIFIED ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# --- Global Environment & App Identity ---
APP_NAME="Ravisn Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://platform.ravisn.com
AGENT_API_URL=http://fastapi_agent:8000

# --- Database (Single Source of Truth: PostgreSQL 16 + pgvector) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ravisn_db
DB_USERNAME=ravisn_user
DB_PASSWORD=SecureProductionPassword123!
POSTGRES_USER=ravisn_user
POSTGRES_PASSWORD=SecureProductionPassword123!
POSTGRES_DB=ravisn_db

# Database URLs for Python / FastAPI:
DATABASE_ASYNC_URL=postgresql+asyncpg://ravisn_user:SecureProductionPassword123!@postgres:5432/ravisn_db
DATABASE_URL=postgresql://ravisn_user:SecureProductionPassword123!@postgres:5432/ravisn_db

# --- Redis (Queue, Cache, PubSub, LangGraph Memory) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=SecureRedisPassword123!
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_URL=redis://:SecureRedisPassword123!@redis:6379/0

# --- Meta Omni-Channel Integration (WhatsApp, Messenger, Instagram) ---
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret_for_hmac_sha256
META_WEBHOOK_VERIFY_TOKEN=your_secure_random_webhook_verify_token
META_API_VERSION=v21.0

# WhatsApp Default Channel (Fallback)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_SYSTEM_USER_ACCESS_TOKEN=

# Facebook & Instagram Fallback Credentials
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- AI Models & Transcription Engine ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # Fast Whisper fallback

# --- Authentication & Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://platform.ravisn.com/auth/google/callback
JWT_SECRET=your_super_secret_jwt_signing_key_for_service_auth

# --- Storage & File Uploads (S3 / Cloudflare R2) ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=ravisn-platform-media
AWS_URL=https://media.ravisn.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Queue & Worker Concurrency ---
QUEUE_CONNECTION=redis
AGENT_WORKER_CONCURRENCY=8
INBOUND_AI_STREAM_KEY=inbound_ai_jobs
CRM_BROADCAST_CHANNEL=crm_channel_updates
CORS_ORIGINS=*
